# ==============================================================================
# Cloud-Based Task Manager Configuration
# ==============================================================================

# Server Network Settings
PORT=5000
HOST=0.0.0.0

# Storage Engine Toggle: 'local' or 'dynamodb'
# In 'local' mode, data is persisted to server/data/tasks.json and server/uploads/
# In 'dynamodb' mode, data is persisted to Amazon DynamoDB and attachments to Amazon S3
STORAGE_TYPE=local

# AWS Credentials and Region (Only needed when STORAGE_TYPE=dynamodb)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# AWS Resource Names
DYNAMODB_TABLE_NAME=CloudTasks
S3_BUCKET_NAME=cloud-task-manager-attachments
